---
title: Dan's Blog
description: Writing about software development, tools, debugging, and AI-assisted workflows.
pagination:
  data: collections.post
  size: 10
  reverse: true
  alias: posts
---

{% layout "surround/base.liquid" %}

{% block head %}
    <link rel="stylesheet" href="/static/styles/posts.css" />
{% endblock head %}

{% block content %}
    <div class="posts-index section">
        <header class="posts-index__header">
            <h2>Blog Posts</h2>
            <p>Notes on software development, tools, and things that took longer to debug than expected.</p>
            <a class="posts-index__rss mono" href="/feed.xml">RSS feed</a>
        </header>

        {% assign currentYear = "" %}
        {% for post in posts %}
            {% assign postYear = post.date | date: "%Y" %}
            {% if postYear != currentYear %}
                {% unless currentYear == "" %}
                        </div>
                    </section>
                {% endunless %}

                <section class="post-year" aria-labelledby="year-{{ postYear }}">
                    <h2 class="post-year__heading" id="year-{{ postYear }}">{{ postYear }}</h2>
                    <div class="post-year__list">
                {% assign currentYear = postYear %}
            {% endif %}

            <article class="post-summary">
                <h3 class="post-summary__title">
                    <a href="{{ post.url | url }}">{{ post.data.title }}</a>
                </h3>
                <time class="post-summary__date mono" datetime="{{ post.date | date: "%Y-%m-%d" }}">{{ post.date | date: "%B %d %Y" }}</time>
            </article>
        {% endfor %}

        {% unless currentYear == "" %}
                </div>
            </section>
        {% endunless %}

        {% if pagination.href.previous or pagination.href.next %}
            <nav class="pagination" aria-label="Blog pages">
                {% if pagination.href.previous %}
                    <a href="{{ pagination.href.previous }}">Newer posts</a>
                {% endif %}
                {% if pagination.href.next %}
                    <a class="pagination__older" href="{{ pagination.href.next }}">Older posts</a>
                {% endif %}
            </nav>
        {% endif %}
    </div>
{% endblock content %}

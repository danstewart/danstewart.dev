{% layout "surround/base.liquid" %}

{% block head %}
    <!-- Our stuff -->
    <link rel="stylesheet" href="/static/styles/markdown.css" />

    <!-- 3rd party assets -->
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/a11y-dark.min.css" />
    <script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>
    <script>
        hljs.highlightAll();
    </script>
{% endblock head %}

{% block content %}
    {% assign olderPost = collections.post | getPreviousCollectionItem: page %}
    {% assign newerPost = collections.post | getNextCollectionItem: page %}

    <article class="markdown">
        <header class="post-header">
            <a class="post-header__back" href="/posts/">All posts</a>
            <h1>{{ title }}</h1>

            <p class="post-meta mono">
                <span>Published <time datetime="{{ date | date: "%Y-%m-%d" }}">{{ date | date: "%B %d %Y" }}</time></span>
                {% if updated %}
                    <span>Updated <time datetime="{{ updated | date: "%Y-%m-%d" }}">{{ updated | date: "%B %d %Y" }}</time></span>
                {% endif %}
            </p>
        </header>

        <div class="blog-body">
            {{ content }}
        </div>

        <footer class="post-footer">
            <a class="post-footer__all" href="/posts/">All posts</a>

            <nav class="post-navigation" aria-label="More blog posts">
                {% if olderPost %}
                    <a class="post-navigation__link post-navigation__link--older" href="{{ olderPost.url | url }}" rel="prev">
                        <span class="post-navigation__label">Older post</span>
                        <span>{{ olderPost.data.title }}</span>
                    </a>
                {% endif %}

                {% if newerPost %}
                    <a class="post-navigation__link post-navigation__link--newer" href="{{ newerPost.url | url }}" rel="next">
                        <span class="post-navigation__label">Newer post</span>
                        <span>{{ newerPost.data.title }}</span>
                    </a>
                {% endif %}
            </nav>
        </footer>
    </article>
{% endblock %}

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="{{ description | default: "Dan Stewart's projects and writing about software development." | escape }}" />
		<meta name="author" content="Dan Stewart" />
		<meta name="color-scheme" content="dark light" />

		<title>{{ title | default: "Dan Stewart" }}</title>
		<script>
			(() => {
				let savedTheme;
				try {
					savedTheme = window.localStorage.getItem("theme");
				} catch {}

				const theme = savedTheme || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
				document.documentElement.classList.toggle("light", theme === "light");
			})();
		</script>

		<link rel="preload" href="/static/fonts/ibm-plex-sans/IBMPlexSans-Regular-Latin1.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/static/fonts/ibm-plex-mono/IBMPlexMono-Regular-Latin1.woff2" as="font" type="font/woff2" crossorigin />

		<!-- From https://favicon.io/ -->
		<link rel="apple-touch-icon" sizes="180x180" href="icons/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="icons/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="icons/favicon-16x16.png" />

		<!-- CSS -->
		<link rel="stylesheet" href="https://unpkg.com/chota@latest" />

		<!-- Our stuff -->
		<link rel="stylesheet" href="/static/styles/main.css" />
		<script src="/static/js/main.js"></script>

		<!-- Child template overrides -->
		{% block head %}{% endblock %}
	</head>

	<body class="bg">
		<header class="site-header">
			<nav class="nav site-nav site-shell" aria-label="Primary navigation">
				<div class="nav-left">
					<h1 class="header-text"><a href="/">danstewart.dev</a></h1>
				</div>
				<div class="nav-right">
					<a class="site-nav__text-link" href="/posts/"{% if page.url contains "/posts/" %} aria-current="page"{% endif %}>Blog</a>
					<a class="site-nav__icon-link" href="https://github.com/danstewart" aria-label="GitHub" title="GitHub"><ion-icon name="logo-github" aria-hidden="true"></ion-icon></a>
					<a class="site-nav__icon-link" rel="me" href="https://fosstodon.org/@danstewart_" aria-label="Mastodon" title="Mastodon"><ion-icon name="logo-mastodon" aria-hidden="true"></ion-icon></a>
					<a class="site-nav__icon-link" href="https://www.linkedin.com/in/daniel-stewart-a699531b3/" aria-label="LinkedIn" title="LinkedIn"><ion-icon name="logo-linkedin" aria-hidden="true"></ion-icon></a>
					<button class="site-nav__icon-link theme-toggle" id="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch to light theme"><ion-icon name="sunny-outline" aria-hidden="true"></ion-icon></button>
				</div>
			</nav>
		</header>
		<main>
			<div class="content site-shell">
				{% block content %}
				{% endblock %}
			</div>
		</main>

		<script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
		<script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
	</body>
</html>

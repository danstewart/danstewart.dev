<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="{{ description | default: "Dan Stewart's projects and writing about software development." | escape }}" />
		<meta name="author" content="Dan Stewart" />
		<meta name="color-scheme" content="dark light" />

		<title>{{ title | default: "Dan Stewart" }}</title>
		<script>
			(() => {
				let savedTheme;
				try {
					savedTheme = window.localStorage.getItem("theme");
				} catch {}

				const theme = savedTheme || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
				document.documentElement.classList.toggle("light", theme === "light");
			})();
		</script>

		<link rel="preload" href="/static/fonts/ibm-plex-sans/IBMPlexSans-Regular-Latin1.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/static/fonts/ibm-plex-mono/IBMPlexMono-Regular-Latin1.woff2" as="font" type="font/woff2" crossorigin />

		<link rel="icon" href="/static/icons/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" sizes="180x180" href="/static/icons/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/static/icons/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/static/icons/favicon-16x16.png" />
		<link rel="alternate" href="/feed.xml" type="application/rss+xml" title="Dan's Blog" />

		<!-- CSS -->
		<link rel="stylesheet" href="/static/vendor/chota/0.9.2/chota.min.css" />

		<!-- Our stuff -->
		<link rel="stylesheet" href="/static/styles/main.css" />
		<script src="/static/js/main.js"></script>

		<!-- Child template overrides -->
		{% block head %}{% endblock %}
	</head>

	<body class="bg">
		<header class="site-header">
			<nav class="nav site-nav site-shell" aria-label="Primary navigation">
				<div class="nav-left">
					<h1 class="header-text"><a href="/">danstewart.dev</a></h1>
				</div>
				<div class="nav-right">
					<a class="site-nav__text-link" href="/posts/"{% if page.url contains "/posts/" %} aria-current="page"{% endif %}>Blog</a>
					<a class="site-nav__icon-link" href="https://github.com/danstewart" aria-label="GitHub" title="GitHub"><span class="site-nav__icon" aria-hidden="true">{% include "icons/ionicons/5.5.2/logo-github.svg" %}</span></a>
					<a class="site-nav__icon-link" rel="me" href="https://fosstodon.org/@danstewart_" aria-label="Mastodon" title="Mastodon"><span class="site-nav__icon" aria-hidden="true">{% include "icons/ionicons/5.5.2/logo-mastodon.svg" %}</span></a>
					<a class="site-nav__icon-link" href="https://www.linkedin.com/in/daniel-stewart-a699531b3/" aria-label="LinkedIn" title="LinkedIn"><span class="site-nav__icon" aria-hidden="true">{% include "icons/ionicons/5.5.2/logo-linkedin.svg" %}</span></a>
					<button class="site-nav__icon-link theme-toggle" id="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch to light theme">
						<span class="site-nav__icon theme-toggle__sun" aria-hidden="true">{% include "icons/ionicons/5.5.2/sunny-outline.svg" %}</span>
						<span class="site-nav__icon theme-toggle__moon" aria-hidden="true">{% include "icons/ionicons/5.5.2/moon-outline.svg" %}</span>
					</button>
				</div>
			</nav>
		</header>
		<main>
			<div class="content site-shell">
				{% block content %}
				{% endblock %}
			</div>
		</main>
	</body>
</html>
